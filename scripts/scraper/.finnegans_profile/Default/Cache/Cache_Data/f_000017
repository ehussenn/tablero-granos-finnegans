function goFinnegansGoLogin() {
	var form = document.forms['loginForm'];
	var empresa = form["empresa"].value;
	var language = form["idioma"].value;
	var callback = function (data){
		showLoading();
		var redirectURL = data.url.substring(0, data.url.indexOf("/BSA"));
		var host = "https://auth.finneg.com";
		var clientID = "TEAMPLACE_app_ID";
		var finnegLoginURL = host + "/api/finneg/auth/v1/chooseAccount?client_id=" + clientID + "&state=" + empresa + "&idioma=" + language + "&redirectUrl=" + redirectURL;

		window.location.href = finnegLoginURL;
	}
	goLogin(callback);
}

function getUrlParameter(sParam) {
	var sPageURL = window.location.search.substring(1),
		sURLVariables = sPageURL.split('&'),
		sParameterName,
		i;
	for (i = 0; i < sURLVariables.length; i++) {
		sParameterName = sURLVariables[i].split('=');

		if (sParameterName[0] === sParam) {
			return sParameterName[1] === undefined ? true : decodeURIComponent(sParameterName[1]);
		}
	}
};

function initPage() {
	if (isSyngentaLogin()) {
		applySyngentaLoginStyles();
	}

	if (isGoyaikeLogin()) {
		applyGoyaikeLoginStyles();
	}

	var redirectResponse = getUrlParameter("redirectResponse");
	var loginError = getUrlParameter("loginError");
	var sessionExpired = getUrlParameter("sessionExpired");
	var changePassword = getUrlParameter("changePassword");
	var enterEmail = getUrlParameter("enterEmail");

	if (redirectResponse != null && redirectResponse != "") {
		showLoading();
		window.location.href = redirectResponse;
	}else{
		$('#loginForm').css('visibility', 'visible');
		$('#loading').css('visibility', 'hidden');
		if (sessionExpired != null && sessionExpired != "" ) {
			setValuesFromCookies();
			setFingerPrint();
			showError("La sesión ha expirado.<br/> Por favor inicie sesión nuevamente.");
		}else if (loginError != null && loginError != "") {
			setValuesFromCookies();
			setFingerPrint();
			const search = '\\+';
			const searchRegExp = new RegExp(search, 'g')
			const replace = ' ';
			showError(loginError.replace (searchRegExp,replace));
		}
		showChangePassword(changePassword);
		showEmail(enterEmail);
		setTogglePassword();
		$('.news-iframe').attr('src', GO_NOVEDADES_URL);
	}
}

