let username = "";
let password = "";
let domain = "";
const PASS_ERROR_LOGIN = "wrong password"


function containsQuippos(palabra) {
	let expression = /QUIPPOS/i;
	return expression.test(palabra);
}

async function loginF4(tipo) {
    
	domain = document.getElementById('logincompany').value;
	password = document.getElementById('loginpassword').value;
	username = document.getElementById('loginname').value;
	if (!containsQuippos(domain)){
		try{
			if((password && username)|| tipo == "google"){
				if(domain && domain.trim() != ''){
					let modeF4 = false;
					try {
						let response = await fetch(URL_BASE_GO + '/api/1/domains/' + domain.toUpperCase() + '/info');
						let jsonResponse = await response.json();
						modeF4 = jsonResponse.modeF4;
					} catch(err) {}
					setCookies();
					if(modeF4) {
						console.log("Sos F4");
						//domain
						let language = document.getElementById('loginlanguage').value;

						language = language === "" ? "SP" : language;

						let goLoginData = {
							email : username,
							password : password,
							domain : domain.toUpperCase(),
							language: language
						}

						//if(e.originalEvent.submitter.classList.contains('google')){
						if((tipo == "google") || (tipo == "finnegansGo")){
							window.location.href = URL_BASE_GO + "/auth/google/login?teamplaceOrigin=access&domain="+domain.toUpperCase()+"&language="+language;
						}else{
							let goLoginResponse = await fetch(URL_BASE_GO + "/auth/login", { method : 'POST', body: JSON.stringify(goLoginData)});
							if (goLoginResponse.status === 203 || goLoginResponse.status === 204) {
								// Migration login
								let myModal = new bootstrap.Modal(document.getElementById('modal1'), { backdrop: true,
									keyboard: true, focus: true });

								if (goLoginResponse.status === 203) {
									let jsonGoLoginResponse = await goLoginResponse.json();
									console.log("the email configured in Teamplace: " + jsonGoLoginResponse.email);
									$("#configured_email").val(jsonGoLoginResponse.email);
								}

								myModal.show();
							} else if (goLoginResponse.status === 200) {
								// Success login
								let jsonGoLoginResponse = await goLoginResponse.json();
								window.location.href = URL_BASE_GO + "/login/external?eco_token=" + jsonGoLoginResponse.token;
							} else if (goLoginResponse.status === 202) {
								let jsonGoLoginResponse = await goLoginResponse.json();
								const action = jsonGoLoginResponse.action;
								if (action=="setup" || action=="verify") {
									window.location.href = URL_BASE_GO + "/two-fa/"+ jsonGoLoginResponse.temp_token+"?action="+action;
								}

							}else {
								// Error login
								let errorLoginResponse = await goLoginResponse.json();
								let errMessage;
								if (goLoginResponse.status === 401 && errorLoginResponse.error === PASS_ERROR_LOGIN) {
									errMessage = "La contraseña es incorrecta. Por favor intente nuevamente."
								} else {
									errMessage = errorLoginResponse.error;
								}
								showError(errMessage)
							}
						}
					} else {

						if (tipo == "finnegans"){
							goFinnegansLogin();
						}else if (tipo == "google"){
							goGoogleLogin();
						}else if (tipo == "finnegansGo"){
							goFinnegansGoLogin();
						}
					}
				}else{
					errMessage = "Por favor ingrese un espacio de trabajo"
					showError(errMessage)
				}
			}else{
				errMessage = "Por favor ingrese usuario y/o contraseña"
				showError(errMessage)
			}
		}catch(err){
			console.log(err);
		}
	} else {
		let domainMayus = domain.toUpperCase();
		errMessage = `La empresa ${domainMayus} no existe. Por favor intente nuevamente.`
		showError(errMessage)
	}
}

function goLogin(callBack) {
	setCookies();
	showLoading();
	var form = document.forms['loginForm'];
	var domain = form["empresa"].value

	$.ajax({
		url : window.location.origin+'/login/selectDomain?domain=' + domain,
		type : 'GET',
		data : {},
		dataType:'json',
		success : function(data) {
			callBack(data);
		},
		error : function(request,error)
		{
			showError(JSON.parse(request.responseText).error);
		}
	});
}

function goFinnegansLogin() {
	var form = document.forms['loginForm'];
