async function loginSSO() {
	domain = document.getElementById('logincompany').value;
	if (!domain || domain.trim() === "") {
		showError('Por favor ingrese un espacio de trabajo')
		return
	}
	try {
		const response = await fetch(URL_BASE_GO_EKS + '/api/1/edt-config/authentications/' + domain.toUpperCase());
		if (!response.ok) throw response;
		const jsonResponse = await response.json();
		if (jsonResponse && Array.isArray(jsonResponse) && jsonResponse.length > 0) {
			let idProveedor = jsonResponse[0].id;
			window.location.href = (`${URL_BASE_GO_EKS}/auth/generic/login/${idProveedor}?domain=${domain}`);
		} else {
			showModalErrorSSO();
		}

	} catch (e) {
		if (e.status === 403) {
			showModalErrorSSO();
		}
		if (e.status === 404) {
			const domainError = `La empresa ${domain} no existe. Por favor intente nuevamente.`
			showError(domainError);
		}

	}

}

