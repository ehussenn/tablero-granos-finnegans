	helpModal.show();
	
	document.getElementById('helpEmail').addEventListener('input', validateHelpForm);
	document.getElementById('helpWorkspace').addEventListener('input', validateHelpForm);
	document.getElementById('helpMessage').addEventListener('input', validateHelpForm);
	
	validateHelpForm();
}

function validateHelpForm() {
	const email = document.getElementById('helpEmail').value.trim();
	const workspace = document.getElementById('helpWorkspace').value.trim();
	const message = document.getElementById('helpMessage').value.trim();
	const sendBtn = document.getElementById('sendHelpBtn');
	
	if (email && workspace) {
		sendBtn.disabled = false;
		sendBtn.classList.remove('btn-secondary');
		sendBtn.classList.add('btn-success');
	} else {
		sendBtn.disabled = true;
		sendBtn.classList.remove('btn-success');
		sendBtn.classList.add('btn-secondary');
	}
}

async function sendHelpRequest() {
	const sendBtn = document.getElementById('sendHelpBtn');

	if (sendBtn.disabled) {
		return;
	}
	$('#loading').css({
		'visibility': 'visible',
		'z-index': '9999',
		'pointer-events': 'none',
	});
    $('#loading').show();

	sendBtn.disabled = true;
	sendBtn.classList.remove('btn-success');
	sendBtn.classList.add('btn-secondary');
	
	const email = document.getElementById('helpEmail').value.trim();
	const workspace = document.getElementById('helpWorkspace').value.trim();
	const message = document.getElementById('helpMessage').value.trim();
	
	const requestBody = {
		email: email,
		edt: workspace,
		description: message
	};
	
	try {
		var helpModal = bootstrap.Modal.getInstance(document.getElementById('helpModal'));
		helpModal.hide();
		const response = await fetch(`${URL_BASE_GO}/api/1/portal-casos/access-problem`, {
			method: 'POST',
			headers: {
				'Content-Type': 'application/json',
			},
			body: JSON.stringify(requestBody)
		});
	} catch (error) {
		console.error('Error al enviar la solicitud:', error);
	}
	
	$('#loading').css({
		'visibility': 'hidden',
		'z-index': '',
		'pointer-events': '',
	});

	
	document.getElementById('helpForm').reset();
	
	var successModal = new bootstrap.Modal(document.getElementById('successModal'));
	successModal.show();
}
