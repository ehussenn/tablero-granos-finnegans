# Credenciales para API Finnegans (Teamplace)
# Copiar como .env y completar con valores reales.
# El archivo .env esta ignorado por git (ver .gitignore).
# En GitHub Actions se cargan desde Secrets, no desde aca.

FINNEGANS_CLIENT_ID=tu_client_id_aca
FINNEGANS_CLIENT_SECRET=tu_client_secret_aca

# Opcionales: solo necesarios si usas scripts/scraper/scrape_view.py (Playwright)
# para scrapear vistas web que no tienen API REST
FINNEGANS_WEB_USER=usuario@empresa.com.ar
FINNEGANS_WEB_PASSWORD=password
FINNEGANS_WORKSPACE=ESPACIODETRABAJO
